{
 "_doc": {
  "purpose": "Maps MODIFIER_VALUE_* property types onto stat-panel rows and declares how each combines. Covers all 58 types present in the live 156-item catalogue (2026-08-06).",
  "kind": {
   "flat": "summed; applied after percentages",
   "add_pct": "summed as percentages, applied once as (1 + sum/100)",
   "mult_pct": "combined as 1 - product(1 - r); see RESOLVER_SPEC.md section 3",
   "reduction": "multiplicative like mult_pct, but SUBTRACTED from the matching resist",
   "info": "displayed on the item, never aggregated into a panel row",
   "enemy": "a debuff applied to the ENEMY, stored as a POSITIVE magnitude (Suppressor 'Fire Rate 28' is 28% slower for them). The build step's negative-value filter cannot catch these, so they are excluded here instead. Never aggregate; the calculator is scoped to your own hero."
  },
  "panel": "G weapon | V vitality | S spirit | null = other-bonuses list",
  "row": "null means the type is real but has no panel row; it renders in the item's own effect list. A list means the type feeds several rows at once.",
  "outputs": "rows computed by the resolver from weapon_info and hero stats rather than fed by any item property; listed in _outputs below"
 },
 "_outputs": {
  "G.bullet_damage": {
   "formula": "damage_per_shot * (1 + weapon_damage_pct/100)",
   "note": "damage_per_shot ALREADY includes pellet count - never multiply by `bullets`"
  },
  "G.bullets_per_sec": {
   "formula": "burst_shot_count / (cycle_time + burst_shot_count * intra_burst_cycle_time) * (1 + fire_rate/100)",
   "note": "verified exact against Valve's shots_per_second on all 38 heroes"
  },
  "G.dps": {
   "formula": "bullet_damage * bullets_per_sec"
  },
  "G.reload_time": {
   "formula": "reload_duration * (1 - reload_reduction/100)"
  },
  "G.bullet_velocity": {
   "formula": "bullet_speed * (1 + velocity_pct/100)"
  },
  "G.clip_size": {
   "formula": "clip_size * (1 + clip_size_pct/100) + ammo"
  },
  "G.light_melee": {
   "formula": "hero light melee base * (1 + melee_damage/100)"
  },
  "G.heavy_melee": {
   "formula": "hero heavy melee base * (1 + melee_damage/100)"
  },
  "G.falloff": {
   "formula": "[damage_falloff_start_range, damage_falloff_end_range] * (1 + falloff_range/100)"
  },
  "V.crit_reduction": {
   "formula": "from crit_resist; no item property feeds it in the current catalogue"
  },
  "V.stamina_cooldown": {
   "formula": "hero stamina cooldown base; no item property feeds it"
  },
  "S.spirit_power": {
   "formula": "flat TECH_POWER sum + hero cost_bonuses.spirit at souls spent",
   "note": "spirit's souls bonus is FLAT power; weapon and vitality's are percentages"
  },
  "*.total_spent": {
   "formula": "sum of item cost within the category"
  },
  "_note": "Souls investment enters via hero cost_bonuses at the highest threshold reached - it is a step function, never interpolated."
 },
